<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.luyublog</groupId>
    <artifactId>aidemo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>aidemo</name>
    <description>aidemo</description>
    <properties>
        <java.version>17</java.version>
        <spring-ai.version>1.1.7</spring-ai.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring AI commons：仅用其 TokenTextSplitter + Document 做纯文本切片。
             不引 spring-ai-starter-model-openai，chat 自己用 OkHttp 调 vLLM（见 VllmChatClient）。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-commons</artifactId>
        </dependency>

        <!-- Qdrant 官方 Java 客户端，走 gRPC（端口 6334）；
             刻意不用 Spring AI 的 QdrantVectorStore：它只支持 dense，做不了 sparse 混合检索 -->
        <dependency>
            <groupId>io.qdrant</groupId>
            <artifactId>client</artifactId>
            <version>1.13.0</version>
        </dependency>
        <!-- io.qdrant:client 把传递依赖都打成 runtime scope，但我们的源码直接引用了
             ListenableFuture / ManagedChannel / GeneratedMessageV3 等类型，需要它们出现在
             compile classpath。显式把 grpc-protobuf 提升到 compile，它会把 grpc-api、
             protobuf-java、guava 一并带到编译期。版本和 qdrant client 1.13.0 自带的对齐。 -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>1.65.1</version>
        </dependency>
        <!-- 同样 runtime → compile 提升：QdrantHybridStore 直接用了 Guava 的 ListenableFuture
             作为 awaitCall 的入参类型 -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>32.1.3-android</version>
        </dependency>

        <!-- OkHttp：BgeM3Client 调 BGE-M3 服务、VllmChatClient 调 vLLM OpenAI 兼容接口都走这个。
             选 OkHttp 是因为它自带 ConnectionPool 和稳定的请求体序列化，
             绕开 Spring 客户端的 MessageConverter 在 vLLM/FastAPI 这种严格服务上踩坑的问题。 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>4.12.0</version>
        </dependency>
        <!-- OkHttp 的 Server-Sent Events 支持，给 vLLM 流式 chat 用 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-sse</artifactId>
            <version>4.12.0</version>
        </dependency>
        <!-- Reactor Core：RagService 的流式接口返回 Flux<String>。
             之前由 spring-ai 拖进来，现在 Spring AI 拔了要单独显式声明 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>spring-snapshots</id>
            <name>Spring Snapshots</name>
            <url>https://repo.spring.io/snapshot</url>
            <releases>
                <enabled>false</enabled>
            </releases>
        </repository>
    </repositories>

</project>
